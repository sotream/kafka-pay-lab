{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "OTEL_ENABLED",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "METRICS_ENABLED",
    "METRICS_HOST",
    "METRICS_PORT",
    "LOG_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "agentGuidance": false
}
