# Copy to .env (`cp .env.example .env`). APP_ENV is required; the other values are the built-in defaults.
# Docker Compose and the API both read this file.

# --- Infra (docker-compose host ports and Postgres credentials) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_UI_PORT=8080

# --- API ---
# Required, no default. dev | prod. prod enforces strong secrets and an https WEB_ORIGIN (see docs/guides/deployment.md).
APP_ENV=dev
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Rate limiting window and limit (auth endpoints use a stricter fixed limit, see auth.constants.ts)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Auth. JWT_ACCESS_SECRET must be set (32+ chars) in production; the dev default is rejected there.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Cleanup job for expired and revoked refresh tokens. Retention must be >= REFRESH_TOKEN_TTL_DAYS.
REFRESH_CLEANUP_CRON=0 3 * * *
REFRESH_REVOKED_RETENTION_DAYS=14

# Messaging (optional). Start the broker with `pnpm infra:up`, then set KAFKA_ENABLED=true.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kafka-pay-lab-api
KAFKA_GROUP_ID=kafka-pay-lab-api

# --- Payments lab ---
# Own consumer group, so payments lag is not mixed with the starter's vehicles consumer.
PAYMENTS_GROUP_ID=kafka-pay-lab-payments
PSP_URL=http://localhost:4100
PSP_TIMEOUT_MS=3000
# Circuit breaker: opens after N consecutive provider failures, probes again after the reset timeout.
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=10000
# Total tries per message (first try included) and the first backoff step (doubles each retry).
PAYMENT_MAX_ATTEMPTS=4
PAYMENT_RETRY_BASE_MS=1000
OUTBOX_POLL_MS=500
LAG_POLL_MS=1000
# Web dashboard (read at build/dev time by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PSP_URL=http://localhost:4100
NEXT_PUBLIC_KAFKA_UI_URL=http://localhost:8080
