{
  "uid": "circuit-breaker",
  "title": "Circuit breaker",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": ["kafka-pay-lab"],
  "links": [
    {
      "title": "Traces in Tempo",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22refId%22:%22A%22,%22queryType%22:%22traceql%22,%22query%22:%22%7Bresource.service.name%3D%5C%22kafka-pay-lab-api%5C%22%7D%22%7D%5D%7D"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (payments_breaker_state) == 1",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "State over time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "payments_breaker_state",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transitions per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from, to) (increase(payments_breaker_transitions_total[1m]))",
          "legendFormat": "{{from}} -> {{to}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Share of time OPEN (5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(payments_breaker_state{state=\"OPEN\"}[5m])",
          "legendFormat": ""
        }
      ]
    }
  ]
}
